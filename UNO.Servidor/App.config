<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- Puerto TCP donde escucha el servidor (abrirlo en el firewall de esta PC) -->
    <add key="Puerto" value="5000" />
    <!-- La API normalmente corre en la misma PC que el servidor -->
    <add key="UrlApi" value="http://127.0.0.1:8000/" />
  </appSettings>
</configuration>
