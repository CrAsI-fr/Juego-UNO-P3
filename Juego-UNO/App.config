<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
  <appSettings>
    <!-- Servidor que se sugiere en "EN RED" (la IP de la PC donde corre UNO.Servidor) -->
    <add key="ServidorIp" value="127.0.0.1" />
    <add key="ServidorPuerto" value="5000" />
    <!-- API de Python para el modo de una sola PC (boton JUGAR) -->
    <add key="UrlApi" value="http://127.0.0.1:8000/" />
  </appSettings>
</configuration>